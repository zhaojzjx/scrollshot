<Window x:Class="ScrollShot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="780" Height="580" MinWidth="700" MinHeight="500"
        Background="{StaticResource BgBase}" Foreground="{StaticResource TextMain}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="164"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧分类（UI-34~38）：选中态由 Theme.xaml 的 ListBoxItem 模板统一绘制 -->
        <ListBox x:Name="CatList" Grid.Column="0" Background="{StaticResource Panel}" BorderThickness="0"
                 Padding="6,8" SelectionChanged="CatList_SelectionChanged">
            <ListBoxItem Content="常规" Tag="g0"/>
            <ListBoxItem Content="采集" Tag="g1"/>
            <ListBoxItem Content="拼接" Tag="g2"/>
            <ListBoxItem Content="输出" Tag="g3"/>
            <ListBoxItem Content="高级" Tag="g4"/>
        </ListBox>

        <ScrollViewer Grid.Column="1" Margin="18,14,18,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 常规 -->
                <GroupBox x:Name="g0" Header="常规">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="启动快捷键" Width="130" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="HotkeyBox" Width="170"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintStyle}" Margin="130,6,0,8"
                                   Text="改成想要的组合键后点右侧按钮即时生效，无需重启程序。"/>
                        <Button x:Name="RebindBtn" Content="重新注册快捷键" Width="150" HorizontalAlignment="Left"
                                Margin="130,0,0,10" Style="{StaticResource BtnPrimary}" Click="RebindBtn_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="关闭主窗口时" Width="130" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CloseCombo" Width="170">
                                <ComboBoxItem Content="最小化到托盘"/>
                                <ComboBoxItem Content="退出"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="语言" Width="130" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="LangCombo" Width="170">
                                <ComboBoxItem Content="简体中文"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 采集 -->
                <GroupBox x:Name="g1" Header="采集" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="滚动步长(占高度)" Width="150" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="StepSlider" Width="200" Minimum="50" Maximum="85" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="StepSlider_Changed"/>
                            <TextBlock x:Name="StepLabel" Width="56" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="滚动方式" Width="150" Style="{StaticResource LabelStyle}"/>
                            <RadioButton x:Name="WheelRb" Content="鼠标滚轮" GroupName="Scroll"
                                         VerticalAlignment="Center" Checked="ScrollMethod_Changed"/>
                            <RadioButton x:Name="PageRb" Content="PageDown" GroupName="Scroll"
                                         VerticalAlignment="Center" Margin="16,0,0,0" Checked="ScrollMethod_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="滚动后等待(ms)" Width="150" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="WaitSlider" Width="200" Minimum="100" Maximum="1000" TickFrequency="50"
                                    IsSnapToTickEnabled="True" ValueChanged="WaitSlider_Changed"/>
                            <TextBlock x:Name="WaitLabel" Width="56" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="稳定帧数" Width="150" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="StableSlider" Width="200" Minimum="1" Maximum="6" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="StableSlider_Changed"/>
                            <TextBlock x:Name="StableLabel" Width="56" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="稳定采样间隔(ms)" Width="150" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="StableIntSlider" Width="200" Minimum="50" Maximum="300" TickFrequency="10"
                                    IsSnapToTickEnabled="True" ValueChanged="StableIntSlider_Changed"/>
                            <TextBlock x:Name="StableIntLabel" Width="56" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="开始前倒计时" Width="150" Style="{StaticResource LabelStyle}"/>
                            <CheckBox x:Name="CountdownCb" Content="开启" VerticalAlignment="Center"
                                      Checked="CountdownCb_Changed" Unchecked="CountdownCb_Changed"/>
                            <Slider x:Name="CountdownSlider" Width="120" Minimum="1" Maximum="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="CountdownSlider_Changed"
                                    Margin="16,0,0,0"/>
                            <TextBlock x:Name="CountdownLabel" Width="44" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="最大卷数" Width="150" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="MaxVolBox" Width="110" LostFocus="MaxVolBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="累计总高度(px)" Width="150" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="MaxHBox" Width="110" LostFocus="MaxHBox_LostFocus"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 拼接 -->
                <GroupBox x:Name="g2" Header="拼接" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="中部带状匹配占比" Width="150" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="BandSlider" Width="200" Minimum="30" Maximum="90" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="BandSlider_Changed"/>
                            <TextBlock x:Name="BandLabel" Width="56" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="单张最大高度(px)" Width="150" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="MaxVHBox" Width="110" LostFocus="MaxVHBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="卷间重叠(px)" Width="150" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="OverlapBox" Width="110" LostFocus="OverlapBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="切点优化" Width="150" Style="{StaticResource LabelStyle}"/>
                            <CheckBox x:Name="CutCb" Content="优先切在行间空白" VerticalAlignment="Center"
                                      Checked="CutCb_Changed" Unchecked="CutCb_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 输出 -->
                <GroupBox x:Name="g3" Header="输出" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保存位置" Width="110" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="DirBox" Width="320"/>
                            <Button x:Name="BrowseBtn" Content="浏览" Width="70" Margin="8,0,0,0"
                                    Click="BrowseBtn_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="默认格式" Width="110" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="FormatCombo" Width="120" SelectionChanged="FormatCombo_Changed">
                                <ComboBoxItem Content="PNG"/>
                                <ComboBoxItem Content="JPG"/>
                            </ComboBox>
                            <Slider x:Name="JpgSlider" Width="160" Minimum="10" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="JpgSlider_Changed" Margin="16,0,0,0"/>
                            <TextBlock x:Name="JpgLabel" Width="50" Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="自动复制" Width="110" Style="{StaticResource LabelStyle}"/>
                            <CheckBox x:Name="AutoCopyCb" Content="启用" VerticalAlignment="Center"
                                      Checked="AutoCopyCb_Changed" Unchecked="AutoCopyCb_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="复制范围" Width="110" Style="{StaticResource LabelStyle}"/>
                            <RadioButton x:Name="CopyFirstRb" Content="首张" GroupName="Copy"
                                         VerticalAlignment="Center" Checked="CopyScope_Changed"/>
                            <RadioButton x:Name="CopyCurRb" Content="当前张" GroupName="Copy"
                                         VerticalAlignment="Center" Margin="16,0,0,0" Checked="CopyScope_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="截屏方式" Width="110" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="ApiCombo" Width="220" SelectionChanged="ApiCombo_Changed">
                                <ComboBoxItem Content="BitBlt（兼容性好）"/>
                                <ComboBoxItem Content="WGC（可截 GPU 窗口）"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 高级 -->
                <GroupBox x:Name="g4" Header="高级" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RestoreBtn" Content="恢复默认" Width="130" Margin="0,0,8,0"
                                    Click="RestoreBtn_Click"/>
                            <Button x:Name="OpenCfgBtn" Content="打开配置目录" Width="130"
                                    Click="OpenCfgBtn_Click"/>
                        </StackPanel>
                        <Border Background="#26282B" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource HintStyle}" LineHeight="19">
                                配置仅写入 %AppData%\ScrollShot\config.json，不含任何图像数据或历史索引（FR-49）。<LineBreak/>
                                本工具完全离线运行，不发起任何网络请求（NFR-08）。
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,18,10">
            <Button x:Name="DoneBtn" Content="完成" Width="110" Style="{StaticResource BtnPrimary}"
                    Click="DoneBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
