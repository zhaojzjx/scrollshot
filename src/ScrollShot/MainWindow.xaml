<Window x:Class="ScrollShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="滚动截图" Height="560" Width="720" MinHeight="480" MinWidth="640"
        Icon="Assets/app.ico"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgBase}" Foreground="{StaticResource TextMain}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="滚动截图" FontSize="14" Foreground="{StaticResource TextMain}"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 主按钮只保留文字：不再放任何图标（之前 ⬚ 字形缺字被回退字体画成小方框，
                     换成四角括号后用户仍要求去掉，索性纯文字最干净） -->
                <Button x:Name="StartBtn" Content="开始滚动截图" Click="StartBtn_Click"
                        Style="{StaticResource BtnPrimary}"
                        FontSize="14" Padding="20,12" Width="320"/>
                <TextBlock Text="按 Ctrl+Alt+S 或点击此按钮 → 拖框选区 → 松开鼠标即开始采集，图片自动保存"
                           Style="{StaticResource HintStyle}" Margin="0,14,0,0" TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Button x:Name="SettingsBtn" Content="设置" Click="SettingsBtn_Click" Width="96" Margin="4"/>
                    <Button x:Name="FolderBtn" Content="打开保存目录" Click="FolderBtn_Click" Width="132" Margin="4"/>
                </StackPanel>

                <Border Background="#26282B" CornerRadius="6" Padding="14" Margin="0,20,0,0" MinWidth="380">
                    <StackPanel>
                        <TextBlock Text="本次结果" Foreground="{StaticResource TextSub}" FontSize="11.5"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="ResultText" Text="尚无结果，按 Ctrl+Alt+S 开始"
                                   Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel x:Name="ResultActions" Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="Collapsed">
                            <Button x:Name="PreviewBtn" Content="预览" Click="PreviewBtn_Click" Width="80"
                                    Margin="0,0,6,0" Style="{StaticResource BtnSmall}"/>
                            <Button x:Name="CopyFirstBtn" Content="复制首张" Click="CopyFirstBtn_Click" Width="92"
                                    Margin="0,0,6,0" Style="{StaticResource BtnSmall}"/>
                            <Button x:Name="ResultFolderBtn" Content="打开文件夹" Click="FolderBtn_Click" Width="100"
                                    Style="{StaticResource BtnSmall}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪 · 离线运行"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
