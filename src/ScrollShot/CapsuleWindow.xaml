<Window x:Class="ScrollShot.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False"
        Width="330" Height="58" MouseLeftButtonDown="OnDrag"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <Border BorderBrush="#3C3F41" BorderThickness="1" CornerRadius="8"
            Background="#2B2D30" Opacity="0.94">
        <Grid Margin="10,8,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#2F6FE0" Margin="0,0,8,0"/>
                <TextBlock x:Name="Info" Foreground="{StaticResource TextMain}" FontSize="11.5"
                           VerticalAlignment="Center" Text="采集准备中…"/>
                <Button x:Name="PauseBtn" Content="⏸" Width="28" Height="24" Padding="0" Margin="10,0,0,0"
                        Click="Pause_Click" ToolTip="暂停 / 继续"/>
                <Button x:Name="StopBtn" Content="■" Width="28" Height="24" Padding="0" Margin="4,0,0,0"
                        Foreground="{StaticResource Danger}" Click="Stop_Click" ToolTip="停止并保存"/>
                <Button x:Name="DiscardBtn" Content="✕" Width="28" Height="24" Padding="0" Margin="4,0,0,0"
                        Foreground="{StaticResource Danger}" Click="Discard_Click" ToolTip="停止并丢弃当前卷"/>
            </StackPanel>
            <ProgressBar x:Name="Bar" Grid.Row="1" Minimum="0" Maximum="100" Height="6"/>
        </Grid>
    </Border>
</Window>
