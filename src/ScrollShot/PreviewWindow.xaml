<Window x:Class="ScrollShot.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="滚动截图 · 预览" Width="1000" Height="660"
        Background="{StaticResource BgBase}" Foreground="{StaticResource TextMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- 工具栏（UI-25）：控件外观全部由 Theme.xaml 的隐式样式决定，不再逐处写死颜色 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10,10,8,8"
                    VerticalAlignment="Center">
            <ComboBox x:Name="ZoomCombo" Width="132" ToolTip="预览缩放方式"
                      SelectionChanged="ZoomCombo_SelectionChanged">
                <ComboBoxItem Content="适应窗口宽度"/>
                <ComboBoxItem Content="100%"/>
                <ComboBoxItem Content="适应窗口"/>
            </ComboBox>
            <TextBlock x:Name="WarnBadge" Text="⚠ 1 处告警" Foreground="{StaticResource Warn}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
            <Button x:Name="CopyCurBtn" Content="复制当前张" Style="{StaticResource BtnSmall}"
                    Click="CopyCurBtn_Click" Margin="12,0,0,0"/>
            <Button x:Name="CopyAllBtn" Content="复制全部" Style="{StaticResource BtnSmall}"
                    Click="CopyAllBtn_Click" Margin="6,0,0,0"/>
            <Button x:Name="FolderBtn" Content="打开文件夹" Style="{StaticResource BtnSmall}"
                    Click="FolderBtn_Click" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- 预览区（UI-26）：深灰底衬托图片边缘 -->
        <ScrollViewer x:Name="Sv" Grid.Row="1" Grid.Column="0" Background="#26282B"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Viewbox x:Name="Vb" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="Img" Stretch="None"/>
            </Viewbox>
        </ScrollViewer>

        <!-- 卷列表（UI-27/UI-28） -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{StaticResource Panel}">
            <TextBlock DockPanel.Dock="Top" Text="卷列表" Foreground="{StaticResource TextSub}"
                       FontSize="11.5" Margin="12,12,12,4"/>
            <Button DockPanel.Dock="Bottom" x:Name="DiscardBtn" Content="丢弃结果"
                    Style="{StaticResource BtnDanger}" Click="DiscardBtn_Click" Margin="10,8,10,10"/>
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Margin="4,0"
                     SelectionChanged="List_SelectionChanged"/>
        </DockPanel>

        <!-- 状态栏（UI-24/UI-31） -->
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
