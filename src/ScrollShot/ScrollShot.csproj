<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 支持周期已于 2026-11-10 结束，改用 net10.0-windows（LTS，支持到 2028-11）。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>ScrollShot</AssemblyName>
    <RootNamespace>ScrollShot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- exe 的文件图标：会写进 PE 资源，单文件发布后依然是这枚图标 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      单文件发布配置：绿色免安装单文件 exe、自带运行库、无需管理员权限。
      仅对 `dotnet publish` 生效；普通 `dotnet build` 仍输出常规多文件调试集，方便开发调试。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!--
      WPF 依赖少量原生库（DirectX 相关），需设为 self-extract 才能在单文件内随 exe 自带运行库，
      否则首次运行会把原生 dll 解压到临时目录。与 SelfContained 配合实现“自带运行库、免安装”。
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF 对 trimming 支持不完整，保持关闭以避免运行时缺失类型 -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 发布产物只保留单一 exe：不生成 pdb 调试符号（运行不需要） -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 嵌进程序集：窗口标题栏图标 + 托盘 HICON 都取这份，发布后仍保持单文件 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
